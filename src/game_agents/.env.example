# Copy this file to .env (same folder) and fill in your own key.
# .env is gitignored -- it never gets committed.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# "anthropic" (default), "deepseek", or "openai"
GAME_AGENTS_LLM=anthropic

# Optional: override the backend's default model id, e.g. claude-haiku-4-5-20251001
GAME_AGENTS_MODEL=
